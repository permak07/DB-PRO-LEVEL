// ER-диаграмма 3: Анализ взаимоотношений с поставщиками
digraph ER3 {
  rankdir=LR;
  splines=polyline;
  nodesep=0.5;
  ranksep=1.2;
  graph [fontname="DejaVu Sans", fontsize=14, label="Анализ взаимоотношений с поставщиками (шаг: месяц)\nоранжевый — факты, голубой — справочники, серый — legacy/пустые", labelloc=t, labeljust=c];
  node [shape=none, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555", arrowsize=0.9];

  vend [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>vendors</b><br/><font point-size="8">поставщики · 63 строки</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">clientid (название)</td></tr>
    <tr><td align="left">clientgroup → vendorgroup</td></tr>
    <tr><td align="left">cityid → city</td></tr>
    <tr><td align="left">countryid → country</td></tr>
    <tr><td align="left">bankid → banks</td></tr>
    <tr><td align="left">INN, KPP, OGRN, accountn</td></tr>
    <tr><td align="left">discount, bonus, IsUse</td></tr>
    </table>
  >];

  vg [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>vendorgroup</b><br/><font point-size="8">группы поставщиков · 2 строки</font></td></tr>
    <tr><td align="left"><u>vendorgroupid</u> : int (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  city [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>city</b><br/><font point-size="8">города · 5 строк</font></td></tr>
    <tr><td align="left"><u>cityid</u> : int (PK)</td></tr>
    <tr><td align="left">name</td></tr>
    </table>
  >];

  cnt [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>country</b><br/><font point-size="8">страны · 2 строки</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">name, shortname</td></tr>
    </table>
  >];

  banks [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>banks</b><br/><font point-size="8">банки · 1 строка</font></td></tr>
    <tr><td align="left"><u>id</u> (БИК)</td></tr>
    <tr><td align="left">description, account, mfo</td></tr>
    </table>
  >];

  bankinfo [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>bankinfo</b><br/><font point-size="8">выписки · 0 строк</font></td></tr>
    <tr><td align="left">id, dater, accountid</td></tr>
    <tr><td align="left">paymenttype, amount</td></tr>
    </table>
  >];

  addr [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>address</b><br/><font point-size="8">адреса · 0 строк</font></td></tr>
    <tr><td align="left">id, clientid</td></tr>
    <tr><td align="left">address, pickupaddress</td></tr>
    <tr><td align="left">cityid → city</td></tr>
    </table>
  >];

  reg [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>region</b><br/><font point-size="8">регионы · 0 строк</font></td></tr>
    <tr><td align="left">id, description</td></tr>
    <tr><td align="left">countryid → country</td></tr>
    </table>
  >];

  prov [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>province</b><br/><font point-size="8">области · 2 строки</font></td></tr>
    <tr><td align="left"><u>provinceid</u> : bigint (PK)</td></tr>
    <tr><td align="left">name</td></tr>
    </table>
  >];

  cmp [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>bm_Companies</b><br/><font point-size="8">юрлица-контрагенты · 1 строка</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">CompanyName, ShortName</td></tr>
    <tr><td align="left">INN, KPP, OGRN</td></tr>
    </table>
  >];

  contr [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>bm_Contracts</b><br/><font point-size="8">договоры · 0 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">CompanyID → bm_Companies</td></tr>
    <tr><td align="left">VendorID → vendors</td></tr>
    <tr><td align="left">ContractNumber, Period</td></tr>
    </table>
  >];

  ovi [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>ordervendorinfo</b><br/><font point-size="8">условия заказа · 0 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">vendorid → vendors</td></tr>
    <tr><td align="left">productid → product</td></tr>
    <tr><td align="left">minfororder, multiplefororder, cost</td></tr>
    </table>
  >];

  pl [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#FDEBD0"><b>pricelist</b><br/><font point-size="8">прайс-листы · 24 797 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">vendorid → vendors</td></tr>
    <tr><td align="left">productid → product</td></tr>
    <tr><td align="left">groupid → pricegroup</td></tr>
    <tr><td align="left">basecost, dateeff</td></tr>
    </table>
  >];

  prod [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>product</b><br/><font point-size="8">товары · 1 545 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">productid, description</td></tr>
    </table>
  >];

  pg [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>pricegroup</b><br/><font point-size="8">группы цен · 4 строки</font></td></tr>
    <tr><td align="left"><u>pricegroupid</u> : int (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  so [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#FDEBD0"><b>bm_StorageOperations</b><br/><font point-size="8">история закупок · 1 031 198 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">VendorID → vendors</td></tr>
    <tr><td align="left">ProductID, Count, Amount</td></tr>
    <tr><td align="left">Period (YYYYMM)</td></tr>
    </table>
  >];

  rec [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>receiving</b><br/><font point-size="8">legacy-приёмка · 17 строк</font></td></tr>
    <tr><td align="left">transnumber, vendorid</td></tr>
    <tr><td align="left">quantity, price, dater</td></tr>
    </table>
  >];

  ord [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>orders</b><br/><font point-size="8">legacy-заказы · 6 строк</font></td></tr>
    <tr><td align="left">transnumber, vendorid</td></tr>
    <tr><td align="left">orderquantity, dateshipping</td></tr>
    </table>
  >];

  fob [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>fob</b><br/><font point-size="8">условия поставки · 0 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  cv [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>conversionvendors</b><br/><font point-size="8">коды поставщиков · 0 строк</font></td></tr>
    <tr><td align="left">vendorid, a…a14</td></tr>
    </table>
  >];

  vend -> vg [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  vend -> city [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  vend -> cnt [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  vend -> banks [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  addr -> city [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  reg -> cnt [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  contr -> cmp [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  contr -> vend [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  ovi -> vend [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  ovi -> prod [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  pl -> vend [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  pl -> prod [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  pl -> pg [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  so -> vend [arrowtail=tee, arrowhead=crow, dir=both, label="1:N"];
  rec -> vend [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
  ord -> vend [arrowtail=tee, arrowhead=crow, dir=both, label="1:N", style=dashed];
}
