// ER-диаграмма 1: Анализ закупки продукции
digraph ER1 {
  rankdir=LR;
  splines=polyline;
  nodesep=0.5;
  ranksep=1.2;
  graph [fontname="DejaVu Sans", fontsize=14, label="Анализ закупки продукции (шаг: месяц)\nоранжевый — факты, голубой — справочники, серый — legacy/пустые\nна связи: колонка-ссылка → колонка-ключ (● — много, │ — один)", labelloc=t, labeljust=c];
  node [shape=none, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555", arrowsize=0.9];

  so [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#FDEBD0"><b>bm_StorageOperations</b><br/><font point-size="8">движения товаров · 1 031 198 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">DocumentID → bm_JournalBarnetDocs</td></tr>
    <tr><td align="left">OperationID → bm_StorageOperationsType</td></tr>
    <tr><td align="left">ProductID → product</td></tr>
    <tr><td align="left">VendorID → vendors</td></tr>
    <tr><td align="left">StorageID → storages</td></tr>
    <tr><td align="left">RangeID → size</td></tr>
    <tr><td align="left">Count (кол-во), Price, Amount</td></tr>
    <tr><td align="left">Period (YYYYMM), DateAdd</td></tr>
    </table>
  >];

  jd [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#FDEBD0"><b>bm_JournalBarnetDocs</b><br/><font point-size="8">документы · 55 149 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">JournalID → bm_JournalType</td></tr>
    <tr><td align="left">DocumentTypeID → bm_JournalTypeDocuments</td></tr>
    <tr><td align="left">CompanyID → bm_Companies</td></tr>
    <tr><td align="left">PersonID → personnel</td></tr>
    <tr><td align="left">DocumentNumber, Period, Amount</td></tr>
    </table>
  >];

  sot [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>bm_StorageOperationsType</b><br/><font point-size="8">типы операций · 5 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">Description</td></tr>
    <tr><td align="left">Factor (+1/−1)</td></tr>
    </table>
  >];

  jt [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>bm_JournalType</b><br/><font point-size="8">журналы · 6 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">JournalName</td></tr>
    </table>
  >];

  jtd [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>bm_JournalTypeDocuments</b><br/><font point-size="8">типы документов · 25 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">Description (4 = Поступление)</td></tr>
    <tr><td align="left">JournalID → bm_JournalType</td></tr>
    </table>
  >];

  cmp [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>bm_Companies</b><br/><font point-size="8">юрлица · 1 строка</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">CompanyName, ShortName</td></tr>
    <tr><td align="left">INN, KPP, OGRN</td></tr>
    </table>
  >];

  vend [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>vendors</b><br/><font point-size="8">поставщики · 63 строки</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">clientid (название)</td></tr>
    <tr><td align="left">INN, KPP, OGRN</td></tr>
    <tr><td align="left">cityid, countryid, bankid</td></tr>
    </table>
  >];

  prod [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>product</b><br/><font point-size="8">товары · 1 545 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">productid, cspcid</td></tr>
    <tr><td align="left">description</td></tr>
    <tr><td align="left">CategoryID → category</td></tr>
    <tr><td align="left">SizeID → size</td></tr>
    </table>
  >];

  cat [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>category</b><br/><font point-size="8">категории · 158 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  stor [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>storages</b><br/><font point-size="8">склады · 1 строка</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    <tr><td align="left">ResponsibleID → personnel</td></tr>
    </table>
  >];

  sz [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>size</b><br/><font point-size="8">фасовки · 78 строк</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  pers [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>personnel</b><br/><font point-size="8">сотрудники · 109 строк</font></td></tr>
    <tr><td align="left"><u>personid</u> : int (PK)</td></tr>
    <tr><td align="left">lastname, firstname</td></tr>
    </table>
  >];

  pl [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#FDEBD0"><b>pricelist</b><br/><font point-size="8">прайс-листы · 24 797 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">vendorid → vendors</td></tr>
    <tr><td align="left">productid → product</td></tr>
    <tr><td align="left">groupid → pricegroup</td></tr>
    <tr><td align="left">basecost, dateeff</td></tr>
    </table>
  >];

  pg [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#D6EAF8"><b>pricegroup</b><br/><font point-size="8">группы цен · 4 строки</font></td></tr>
    <tr><td align="left"><u>pricegroupid</u> : int (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  rec [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>receiving</b><br/><font point-size="8">legacy-приёмка · 17 строк (2002–2003)</font></td></tr>
    <tr><td align="left">transnumber</td></tr>
    <tr><td align="left">vendorid → vendors (legacy)</td></tr>
    <tr><td align="left">id → product (legacy)</td></tr>
    <tr><td align="left">quantity, price, amount</td></tr>
    </table>
  >];

  ord [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>orders</b><br/><font point-size="8">legacy-заказы · 6 строк</font></td></tr>
    <tr><td align="left">transnumber</td></tr>
    <tr><td align="left">vendorid → vendors (legacy)</td></tr>
    <tr><td align="left">orderquantity, multiple</td></tr>
    </table>
  >];

  ovi [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>ordervendorinfo</b><br/><font point-size="8">условия заказа · 0 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">vendorid → vendors</td></tr>
    <tr><td align="left">productid → product</td></tr>
    <tr><td align="left">minfororder, cost</td></tr>
    </table>
  >];

  fob [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#EAECEE"><b>fob</b><br/><font point-size="8">условия поставки · 0 строк</font></td></tr>
    <tr><td align="left"><u>id</u> : bigint (PK)</td></tr>
    <tr><td align="left">description</td></tr>
    </table>
  >];

  sotbl [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#FDEBD0"><b>bm_StorageOperations_Table</b><br/><font point-size="8">детали операций · 30 801 строка</font></td></tr>
    <tr><td align="left"><u>ID</u> : bigint (PK)</td></tr>
    <tr><td align="left">DocumentID → bm_JournalBarnetDocs</td></tr>
    <tr><td align="left">OperationID → bm_StorageOperationsType</td></tr>
    <tr><td align="left">ProductID → product</td></tr>
    <tr><td align="left">StorageID → storages</td></tr>
    <tr><td align="left">SourceID → journal.transnumber</td></tr>
    <tr><td align="left">BludoID → product (блюдо)</td></tr>
    </table>
  >];

  so -> jd [arrowtail=crow, arrowhead=tee, dir=both, label="DocumentID → ID"];
  so -> sot [arrowtail=crow, arrowhead=tee, dir=both, label="OperationID → ID"];
  so -> prod [arrowtail=crow, arrowhead=tee, dir=both, label="ProductID → id"];
  so -> vend [arrowtail=crow, arrowhead=tee, dir=both, label="VendorID → id"];
  so -> stor [arrowtail=crow, arrowhead=tee, dir=both, label="StorageID → id"];
  so -> sz [arrowtail=crow, arrowhead=tee, dir=both, label="RangeID → ID"];
  jd -> jt [arrowtail=crow, arrowhead=tee, dir=both, label="JournalID → ID"];
  jd -> jtd [arrowtail=crow, arrowhead=tee, dir=both, label="DocumentTypeID → ID"];
  jd -> cmp [arrowtail=crow, arrowhead=tee, dir=both, label="CompanyID → ID"];
  jd -> pers [arrowtail=crow, arrowhead=tee, dir=both, label="PersonID → personid"];
  prod -> cat [arrowtail=crow, arrowhead=tee, dir=both, label="CategoryID → id"];
  prod -> sz [arrowtail=crow, arrowhead=tee, dir=both, label="SizeID → ID", style=dashed, constraint=false];
  stor -> pers [arrowtail=crow, arrowhead=tee, dir=both, label="ResponsibleID → personid", style=dashed, constraint=false];
  pl -> vend [arrowtail=crow, arrowhead=tee, dir=both, label="vendorid → id"];
  pl -> prod [arrowtail=crow, arrowhead=tee, dir=both, label="productid → id"];
  pl -> pg [arrowtail=crow, arrowhead=tee, dir=both, label="groupid → pricegroupid"];
  ovi -> vend [arrowtail=crow, arrowhead=tee, dir=both, label="vendorid → id", style=dashed];
  ovi -> prod [arrowtail=crow, arrowhead=tee, dir=both, label="productid → productid", style=dashed];
  rec -> vend [arrowtail=crow, arrowhead=tee, dir=both, label="vendorid → id", style=dashed];
  ord -> vend [arrowtail=crow, arrowhead=tee, dir=both, label="vendorid → id", style=dashed];
  sotbl -> jd [arrowtail=crow, arrowhead=tee, dir=both, label="DocumentID → ID"];
  sotbl -> sot [arrowtail=crow, arrowhead=tee, dir=both, label="OperationID → ID"];
  sotbl -> prod [arrowtail=crow, arrowhead=tee, dir=both, label="ProductID → id"];
  sotbl -> stor [arrowtail=crow, arrowhead=tee, dir=both, label="StorageID → id"];
}
